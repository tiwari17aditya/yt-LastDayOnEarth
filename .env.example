# =====================================================================
# Automated Last Day on Earth Video Pipeline Environment Configuration
# =====================================================================

# Environment Mode: development | production | testing
ENVIRONMENT=development
LOG_LEVEL=INFO

# =====================================================================
# Google Cloud Unified OAuth2 Credentials (Drive, YouTube, Gmail)
# Run `python scripts/setup_google_auth.py` to generate these automatically
# =====================================================================
GCP_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GCP_CLIENT_SECRET="your-client-secret"
GCP_REFRESH_TOKEN="your-refresh-token"

# Optional token file path
GCP_TOKEN_FILE="config/token.json"

# =====================================================================
# Google Drive Configuration
# STRICT SAFETY: Pipeline is locked to MyDrive -> youtube-projects -> LastDayOnEarth
# =====================================================================
GDRIVE_PARENT_FOLDER_NAME="youtube-projects"
GDRIVE_PROJECT_FOLDER_NAME="LastDayOnEarth"
GDRIVE_INPUT_FOLDER_NAME="Input"
GDRIVE_PROCESSED_FOLDER_NAME="Processed"

# =====================================================================
# Gmail API & Notification Settings
# =====================================================================
GMAIL_SENDER="me"
NOTIFICATION_RECIPIENTS="your-email@gmail.com"

# Optional legacy SMTP fallback
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password-here"

# =====================================================================
# YouTube Publishing Configuration
# =====================================================================
YOUTUBE_PRIVACY_STATUS="public" # public | unlisted | private

# =====================================================================
# Google Gemini API (Optional vision intelligence)
# =====================================================================
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# =====================================================================
# Video Processing Configurations
# =====================================================================
VIDEO_RESOLUTION="1920x1080"
VIDEO_TARGET_FPS=60
VIDEO_AUDIO_DUCKING_DB="-8dB"
VIDEO_PRESET="veryfast"
TEMP_PROCESSING_DIR="temp"
OUTPUT_DIR="output"
