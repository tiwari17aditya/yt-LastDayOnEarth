# =====================================================================
# Automated Last Day on Earth Video Pipeline Environment Configuration
# =====================================================================

# Environment Mode: development | production | testing
ENVIRONMENT=development
LOG_LEVEL=INFO

# Google Drive Configuration
# Path or Folder ID for incoming recordings and processed archives
GDRIVE_INPUT_FOLDER_NAME="Input 1"
GDRIVE_PROCESSED_FOLDER_NAME="Processed"
GOOGLE_APPLICATION_CREDENTIALS="config/credentials.json"

# Google Gemini API (Vision & Context Analysis)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# YouTube Data API v3 (OAuth2 Client)
YOUTUBE_CLIENT_SECRETS_FILE="config/client_secrets.json"
YOUTUBE_TOKEN_FILE="config/token.json"
YOUTUBE_PRIVACY_STATUS="unlisted" # public | unlisted | private

# Email / SMTP Notification Settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password-here"
NOTIFICATION_RECIPIENTS="your-email@gmail.com"

# Video Processing Configurations
VIDEO_RESOLUTION="1920x1080"
VIDEO_TARGET_FPS=60
VIDEO_AUDIO_DUCKING_DB="-20dB"
TEMP_PROCESSING_DIR="temp"
OUTPUT_DIR="output"
